$ python3 scripts/query.py bool_should
POST /videos/_search
{
  "track_total_hits": true,
  "size": 10,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "is_premium": false
          }
        }
      ],
      "should": [
        {
          "match": {
            "title": "Redis"
          }
        },
        {
          "term": {
            "tags": "redis"
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "sort": [
    {
      "_score": "desc"
    },
    {
      "video_id": "asc"
    }
  ]
}
