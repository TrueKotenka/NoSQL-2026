$ python3 scripts/query.py compare_filtered
POST /videos/_search
{
  "track_total_hits": true,
  "size": 20,
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "данные",
            "fields": [
              "title",
              "description"
            ]
          }
        }
      ],
      "filter": [
        {
          "term": {
            "category": "technology"
          }
        }
      ]
    }
  },
  "sort": [
    {
      "video_id": "asc"
    }
  ]
}
RESULT
total=1
1. v003 score=null views=7137 category=technology title=Базы данных для видеосервиса
Ожидание: Тот же полнотекстовый запрос, но только категория technology.
